# TreasureFlow local config. Copy to .env. Never commit secrets.
# .env is gitignored. Fill NEED NOW first.

# NEED NOW (B0 Bankr treasury)
BANKR_API_KEY=

# NEED BEFORE B2
PAY_DEST_1=
PAY_DEST_2=

# FILLED BY pnpm bankr:me (full address only here, truncated in logs)
TREASURY_ADDRESS=
BANKR_WALLET_ID=

# UNUSED ON THIS BRANCH (Dynamic path lives in /Users/home/Code/Runtime)
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_ID=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# LATER
XAI_API_KEY=
FLASH_API_KEY=

# Policy (human USDC amounts)
BUFFER_USDC=15
PER_CALL_CAP_USDC=10
DAILY_CAP_USDC=30
MIN_SWEEP_USDC=5
MAX_LP_SHARE=0.7
HARD_STOP_USDC=15
DEMO_PAY_USDC=8
DEMO_REJECT_USDC=50

# Runtime
DRY_RUN=true
PAUSED=false
CRON_TZ=America/New_York
DEMO_PAUSE_MS=800
