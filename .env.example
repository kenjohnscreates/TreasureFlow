# TreasureFlow local config. Copy to .env. Never commit secrets.
# .env is gitignored. Fill NEED NOW first.

# Vercel dashboard names only (never commit values):
# BANKR_API_KEY TREASURY_ADDRESS PAY_DEST_1 PAY_DEST_2
# FLASH_API_KEY BASE_RPC_URL CHAT_KEY FOUNDER_ADDRESS
# VITE_DYNAMIC_ENVIRONMENT_ID (unused leftover on Vercel; not required for Connect)
# Optional web/.env VITE_WALLETCONNECT_PROJECT_ID for WalletConnect QR; empty = injected wallets only

# NEED NOW (B0 Bankr treasury)
BANKR_API_KEY=

# NEED BEFORE B2
PAY_DEST_1=
PAY_DEST_2=

# FILLED BY pnpm bankr:me (full address only here, truncated in logs)
TREASURY_ADDRESS=
BANKR_WALLET_ID=

# Sign deposit and live pay; never VITE_*.
FOUNDER_ADDRESS=

# UNUSED ON THIS BRANCH (Dynamic path lives in /Users/home/Code/Runtime)
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_ID=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# LATER
XAI_API_KEY=
FLASH_API_KEY=

# Optional. Bankr LLM Gateway model for NL chat mapping (host llm.bankr.bot).
# Same BANKR_API_KEY (X-API-Key). Default gemini-3-flash.
BANKR_LLM_MODEL=

# B3 live LP is pnpm bankr:lp -- --live (Agent API raw submit, not /wallet/submit)
# B4 live sweep is pnpm bankr:sweep -- --live
# B5 live cbBTC limits is pnpm bankr:limits -- --live (chat stays dry)

# Policy (human USDC amounts)
BUFFER_USDC=15
PER_CALL_CAP_USDC=10
DAILY_CAP_USDC=30
MIN_SWEEP_USDC=5
MAX_LP_SHARE=0.7
HARD_STOP_USDC=15
DEMO_PAY_USDC=8
DEMO_REJECT_USDC=50

# Runtime
DRY_RUN=true
PAUSED=false
CRON_TZ=America/New_York
DEMO_PAUSE_MS=800

# Vercel write gate for POST /chat submit (maybeSubmitChatPay). Unset locally.
# Not a VITE_* var. Header x-treasureflow-key.
CHAT_KEY=
