# TreasureFlow local config. Copy to .env. Never commit secrets.

# Dynamic server wallet
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_ID=

# RPC
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Product chat parser
XAI_API_KEY=

# Flash (M5)
FLASH_API_KEY=

# Bankr (narrated stretch only; optional)
BANKR_API_KEY=

# Allowlisted payment destinations
PAY_DEST_1=
PAY_DEST_2=

# Policy (USDC, 6 decimals as human amounts)
BUFFER_USDC=15
PER_CALL_CAP_USDC=10
DAILY_CAP_USDC=30
MIN_SWEEP_USDC=5
MAX_LP_SHARE=0.7
HARD_STOP_USDC=15
DEMO_PAY_USDC=8
DEMO_REJECT_USDC=50

# Runtime
DRY_RUN=true
PAUSED=false
CRON_TZ=America/New_York
