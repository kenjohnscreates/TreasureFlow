{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "installCommand": "pnpm install && pnpm --dir web install",
  "buildCommand": "pnpm --dir web build",
  "functions": {
    "src/app.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "includeFiles": "web/dist/**"
    },
    "src/chat/http.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "includeFiles": "web/dist/**"
    }
  }
}
